# Model Configuration
# List the model aliases that should be exposed to the frontend.
# The alias is the stable ID shared between backend and frontend, so it must be unique.
LLM_MODELS=openai-gpt-4-1-mini,openai-gpt-4-1-nano,openai-gpt-4-1,openai-gpt-5-mini,openai-gpt-5-nano,openai-gpt-5
DEFAULT_MODEL=openai-gpt-4-1-mini
# Example with Gemini / Vertex AI Gemini:
# LLM_MODELS=openai-gpt-4-1-mini,gemini-2-5-flash,vertex-gemini-2-5-flash

# Env suffix rule:
#   openai-gpt-5-mini   -> OPENAI_GPT_5_MINI
#   openai-gpt-4-1-mini -> OPENAI_GPT_4_1_MINI
#   gemini-2-5-flash    -> GEMINI_2_5_FLASH
#
# Required fields by provider:
# - azure:  PROVIDER, API_KEY, ENDPOINT, DEPLOYMENT
# - openai: PROVIDER, API_KEY, MODEL_ID
# - gemini: PROVIDER, API_KEY, MODEL_ID
# - vertex_gemini: PROVIDER, MODEL_ID, PROJECT, LOCATION
#
# Optional fields:
# - LABEL:     label shown in the frontend
# - API_VERSION: Azure / Gemini / Vertex AI Gemini
# - ENDPOINT:  Azure endpoint, OpenAI-compatible base URL, or custom Gemini base URL
# - BASE_URL:  alias for ENDPOINT on OpenAI / Gemini models
# - ORG_ID:    OpenAI organization ID
# - PROJECT:   Vertex AI project ID
# - LOCATION:  Vertex AI region
# - CREDENTIALS_PATH: service account JSON path for Vertex AI (optional if ADC is configured)
# - REQUIRES_APPROVAL: true | false
# - APPROVAL_REASON: approval dialog message
# - SUPPORTS_MULTIMODAL: true | false
# - SUPPORTS_IMAGE_INPUT: true | false
# - SUPPORTS_PDF_INPUT: true | false
# - INPUT_COST_PER_1K_TOKENS / OUTPUT_COST_PER_1K_TOKENS: optional unit price for Ops Ledger aggregation
# - CURRENCY: e.g. USD

LLM_MODEL_OPENAI_GPT_4_1_MINI_PROVIDER=openai
LLM_MODEL_OPENAI_GPT_4_1_MINI_LABEL=GPT-4.1 Mini (OpenAI)
LLM_MODEL_OPENAI_GPT_4_1_MINI_API_KEY=your-openai-api-key-here
LLM_MODEL_OPENAI_GPT_4_1_MINI_MODEL_ID=gpt-4-1-mini
LLM_MODEL_OPENAI_GPT_4_1_MINI_SUPPORTS_MULTIMODAL=true
LLM_MODEL_OPENAI_GPT_4_1_MINI_SUPPORTS_IMAGE_INPUT=true
LLM_MODEL_OPENAI_GPT_4_1_MINI_SUPPORTS_PDF_INPUT=true

LLM_MODEL_OPENAI_GPT_4_1_NANO_PROVIDER=openai
LLM_MODEL_OPENAI_GPT_4_1_NANO_LABEL=GPT-4.1 Nano (OpenAI)
LLM_MODEL_OPENAI_GPT_4_1_NANO_API_KEY=your-openai-api-key-here
LLM_MODEL_OPENAI_GPT_4_1_NANO_MODEL_ID=gpt-4-1-nano
LLM_MODEL_OPENAI_GPT_4_1_NANO_SUPPORTS_MULTIMODAL=true
LLM_MODEL_OPENAI_GPT_4_1_NANO_SUPPORTS_IMAGE_INPUT=true
LLM_MODEL_OPENAI_GPT_4_1_NANO_SUPPORTS_PDF_INPUT=true

LLM_MODEL_OPENAI_GPT_4_1_PROVIDER=openai
LLM_MODEL_OPENAI_GPT_4_1_LABEL=GPT-4.1 (OpenAI)
LLM_MODEL_OPENAI_GPT_4_1_API_KEY=your-openai-api-key-here
LLM_MODEL_OPENAI_GPT_4_1_MODEL_ID=gpt-4-1
LLM_MODEL_OPENAI_GPT_4_1_SUPPORTS_MULTIMODAL=true
LLM_MODEL_OPENAI_GPT_4_1_SUPPORTS_IMAGE_INPUT=true
LLM_MODEL_OPENAI_GPT_4_1_SUPPORTS_PDF_INPUT=true

LLM_MODEL_OPENAI_GPT_5_MINI_PROVIDER=openai
LLM_MODEL_OPENAI_GPT_5_MINI_LABEL=GPT-5 Mini (OpenAI)
LLM_MODEL_OPENAI_GPT_5_MINI_API_KEY=your-openai-api-key-here
LLM_MODEL_OPENAI_GPT_5_MINI_MODEL_ID=gpt-5-mini
LLM_MODEL_OPENAI_GPT_5_MINI_SUPPORTS_MULTIMODAL=true
LLM_MODEL_OPENAI_GPT_5_MINI_SUPPORTS_IMAGE_INPUT=true
LLM_MODEL_OPENAI_GPT_5_MINI_SUPPORTS_PDF_INPUT=true
LLM_MODEL_OPENAI_GPT_5_MINI_REQUIRES_APPROVAL=true
LLM_MODEL_OPENAI_GPT_5_MINI_APPROVAL_REASON=高コストモデルのためユーザー承認が必要
# LLM_MODEL_OPENAI_GPT_5_MINI_INPUT_COST_PER_1K_TOKENS=0.005
# LLM_MODEL_OPENAI_GPT_5_MINI_OUTPUT_COST_PER_1K_TOKENS=0.015
# LLM_MODEL_OPENAI_GPT_5_MINI_CURRENCY=USD

LLM_MODEL_OPENAI_GPT_5_NANO_PROVIDER=openai
LLM_MODEL_OPENAI_GPT_5_NANO_LABEL=GPT-5 Nano (OpenAI)
LLM_MODEL_OPENAI_GPT_5_NANO_API_KEY=your-openai-api-key-here
LLM_MODEL_OPENAI_GPT_5_NANO_MODEL_ID=gpt-5-nano
LLM_MODEL_OPENAI_GPT_5_NANO_SUPPORTS_MULTIMODAL=true
LLM_MODEL_OPENAI_GPT_5_NANO_SUPPORTS_IMAGE_INPUT=true
LLM_MODEL_OPENAI_GPT_5_NANO_SUPPORTS_PDF_INPUT=true

LLM_MODEL_OPENAI_GPT_5_PROVIDER=openai
LLM_MODEL_OPENAI_GPT_5_LABEL=GPT-5 (OpenAI)
LLM_MODEL_OPENAI_GPT_5_API_KEY=your-openai-api-key-here
LLM_MODEL_OPENAI_GPT_5_MODEL_ID=gpt-5
LLM_MODEL_OPENAI_GPT_5_SUPPORTS_MULTIMODAL=true
LLM_MODEL_OPENAI_GPT_5_SUPPORTS_IMAGE_INPUT=true
LLM_MODEL_OPENAI_GPT_5_SUPPORTS_PDF_INPUT=true

# Gemini Developer API example
# LLM_MODEL_GEMINI_2_5_FLASH_PROVIDER=gemini
# LLM_MODEL_GEMINI_2_5_FLASH_LABEL=Gemini 2.5 Flash (Gemini API)
# LLM_MODEL_GEMINI_2_5_FLASH_API_KEY=your-gemini-api-key-here
# LLM_MODEL_GEMINI_2_5_FLASH_MODEL_ID=gemini-2.5-flash
# LLM_MODEL_GEMINI_2_5_FLASH_SUPPORTS_MULTIMODAL=true
# LLM_MODEL_GEMINI_2_5_FLASH_SUPPORTS_IMAGE_INPUT=true
# LLM_MODEL_GEMINI_2_5_FLASH_SUPPORTS_PDF_INPUT=true

# Vertex AI Gemini example
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_PROVIDER=vertex_gemini
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_LABEL=Gemini 2.5 Flash (Vertex AI)
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_MODEL_ID=gemini-2.5-flash
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_PROJECT=your-gcp-project
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_LOCATION=us-central1
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_CREDENTIALS_PATH=/path/to/service-account.json
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_SUPPORTS_MULTIMODAL=true
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_SUPPORTS_IMAGE_INPUT=true
# LLM_MODEL_VERTEX_GEMINI_2_5_FLASH_SUPPORTS_PDF_INPUT=true

# Optional for OpenAI-compatible gateways:
# LLM_MODEL_OPENAI_GPT_4_1_MINI_ENDPOINT=https://api.openai.com/v1
# LLM_MODEL_OPENAI_GPT_4_1_MINI_ORG_ID=org_xxx
# LLM_MODEL_OPENAI_GPT_5_MINI_ENDPOINT=https://api.openai.com/v1
# LLM_MODEL_OPENAI_GPT_5_MINI_ORG_ID=org_xxx

# Legacy Azure-only fallback is still supported for compatibility:
# AZURE_OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# AZURE_OPENAI_MODEL_GPT_4_1_MINI_API_KEY=
# AZURE_OPENAI_MODEL_GPT_4_1_MINI_ENDPOINT=
# AZURE_OPENAI_MODEL_GPT_4_1_MINI_API_VERSION=
# AZURE_OPENAI_MODEL_GPT_4_1_MINI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_DEPLOYMENT_GPT41=
# AZURE_OPENAI_DEPLOYMENT_GPT41_MINI=
# AZURE_OPENAI_DEPLOYMENT_GPT41_NANO=
# AZURE_OPENAI_DEPLOYMENT_GPT52=
# AZURE_OPENAI_DEPLOYMENT_GPT52_CHAT=

# Azure AI Search Configuration
SEARCH_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_API_KEY=your-search-api-key-here
SEARCH_INDEX_NAME=your-index-name

# App Configuration
LANGUAGE=ja
SESSION_HISTORY_MESSAGES=20
PROMPT_HISTORY_MESSAGES=8
PLAN_TIMEOUT_SECONDS=20
ROUTE_TIMEOUT_SECONDS=8
ENABLE_EVALUATION_AGENT=true
EVALUATION_TIMEOUT_SECONDS=8
MAX_UPLOAD_FILES=5
MAX_UPLOAD_FILE_SIZE_BYTES=5242880
MAX_UPLOAD_TEXT_CHARS=12000
MAX_PROMPT_DOCUMENT_CHARS=8000
# Default: <Backend directory>/data/backend_sessions
# BACKEND_SESSION_STORE_PATH=data/backend_sessions
# Default: <Backend directory>/data/backend_jobs
# BACKEND_JOB_STORE_PATH=data/backend_jobs
# Default: <Backend directory>/data/backend_audit
# BACKEND_AUDIT_STORE_PATH=data/backend_audit
# Default: <Backend directory>/data/backend_upload_assets
# BACKEND_UPLOAD_STORE_PATH=data/backend_upload_assets

# Backend listen port is fixed by the application default (8000).
# With podman-compose, the published host port is managed in podman-compose.yml.
