# Language Configuration
# Supported languages: ja (Japanese), en (English)
LANGUAGE=ja

# Setting to display links to Document Intelligence DEMO
ENABLE_DI_LINK=false

# Frontend listen port is fixed by the application default (5001).
# With podman-compose, the published host port is managed in podman-compose.yml.

# Backend API base URL
# podman-compose overrides this to http://backend:8000
BACKEND_URL=http://localhost:8000
